[{"data":1,"prerenderedAt":318},["ShallowReactive",2],{"$RcJmAH4yb5":3,"$6ckdPRX2kF":240},{"id":4,"title":5,"body":6,"description":13,"extension":14,"meta":15,"navigation":235,"path":236,"seo":237,"stem":238,"__hash__":239},"content/es-es/index.md","Inicio",{"type":7,"value":8,"toc":9},"minimark",[],{"title":10,"searchDepth":11,"depth":11,"links":12},"",2,[],"Equipo líder en gestión de hostelería detrás de cuatro conceptos distintivos de restaurantes","md",{"heroSection":16,"aboutSection":24,"introSection":29,"contactSection":32,"gallerySection":36,"multimediaText":39,"footer":49,"restaurantsSection":71,"visionSection":98,"teamPage":116,"cateringSection":208,"flowerDecorationSection":219,"photoSection":227},{"title":17,"description":18,"image":19,"ctaText1":20,"ctaLink":21,"restaurantsLink":22,"ctaText2":23},"The Next Dream Team","Excelencia en gestión de hostelería a través de múltiples conceptos distintivos de restaurantes","/images/hero.jpg","Contáctenos","/contact","/restaurants","Restaurantes",{"title":17,"description":25,"image":26,"linkText":27,"link":28},"Nuestro equipo de gestión hotelera y de restauración, fundado en 2021, se dedica a deleitar a nuestros clientes con la mejor cocina mediterránea en nuestros cuatro restaurantes ubicados en el corazón de Barcelona. Nuestro objetivo es expandir nuestros servicios y contar con un equipo cada vez más experimentado en el sector, con la visión de alcanzar una proyección internacional en el futuro. Además, nos comprometemos a inspirar a los jóvenes líderes de la comunidad y a ayudarlos a incorporarse al mundo empresarial.","/images/fiestayartagroup.png","Ver miembro de nuestro equipo","/team",{"title":30,"description":31,"image":26},"Suresh Sharma CEO","Suresh Sharma comenzó su trayectoria empresarial en el negocio de hostelería de su familia en Katmandú, Nepal. Actualmente establecido en Barcelona, España, lidera proyectos exitosos en el sector de la hostelería en Europa e inspira a la próxima generación a llevar la industria a un nivel global.",{"title":33,"subtitle":34,"ctaText":20,"image":35,"ctaLink":21},"Creemos Algo Excepcional Juntos","¿Interesado en asociaciones, colaboraciones o unirse a nuestro equipo? Nos encantaría saber de usted.","/images/parallex.jpg",{"images":37,"showVertical":38},[19,19,19,19,19,19],false,[40,45],{"videoSrc":41,"videoPoster":19,"title":42,"description":43,"textPosition":44},"/videos/hero.mp4","Nuestro Portafolio de Restaurantes","Descubra nuestros cuatro conceptos distintivos de restaurantes, cada uno ofreciendo experiencias culinarias únicas en Barcelona.","left",{"videoSrc":41,"videoPoster":19,"title":46,"description":47,"textPosition":48},"Excelencia Culinaria","Desde cocina mediterránea hasta tapas y bares deportivos, nuestros diversos conceptos atienden diferentes gustos y ocasiones.","right",{"restaurant":50,"quickLinks":52,"contact":59,"hours":63},{"name":17,"tagline":51},"Excelencia en gestión de hostelería",{"title":53,"home":5,"menu":54,"about":55,"contact":56,"team":57,"catering":58},"Enlaces Rápidos","Nuestros Restaurantes","Sobre nosotros","Contacto","Equipo","Catering",{"title":20,"phone":60,"email":61,"address":62},"+34 631 81 07 27","dreamteamthenext@gmail.com"," Carrer del Consell de Cent, 424, L'Eixample, 08013 Barcelona",{"title":64,"weekdays":65,"weekend":68},"Horario de Oficina",{"days":66,"hours":67},"Lunes - Viernes","9:00 AM - 6:00 PM",{"days":69,"hours":70},"Sábado - Domingo","Cerrado",{"title":54,"description":43,"list":72},[73,78,83,88,93],{"name":74,"image":75,"link":76,"title":74,"description":77},"Casa Muyo restaurant","/images/restaurants/casamuyo.jpg","https://restaurantecasamuyo.com/","FUNDADO EN 1964 Taps Bar Restaurant",{"name":79,"video":80,"link":81,"title":79,"description":82},"BistroSagrada","/videos/bistro.mp4","https://restaurantebistrosagrada.com/","Bar . Tapas . Restaurant",{"name":84,"image":85,"link":86,"title":84,"description":87},"Restaurante Mediterraneo","/images/restaurants/restaurantemediterraneobcn.jpg","https://restaurantemediterraneobcn.com/","La mejor cocina italiana",{"name":89,"image":90,"link":91,"title":89,"description":92},"Bistro Sants Sports Bar","/images/restaurants/bistro-sants.jpg","https://restaurantebistrosants.com/","Sports Bar . Tapas . Restaurant",{"name":94,"image":95,"link":96,"title":94,"description":97},"Restaurante Santilari Bistro Campnou","/images/restaurants/bistroampnou.jpg","https://restaurantesantilaribistrocampnou.com/","Tapas Bar, Deportes Y Restaurante",{"title":99,"description":100,"list":101},"Nuestra visión","Compromiso inquebrantable con la hospitalidad excepcional y la innovación culinaria",[102,106,111],{"name":103,"icon":104,"link":81,"title":105,"description":100},"Excellence","images/icons/excellence-honor-icon.png","Excelencia",{"name":107,"icon":108,"link":76,"title":109,"description":110},"Team First","images/icons/team.png","Equipo Primero","Construir equipos talentosos que crean experiencias gastronómicas inolvidables",{"name":112,"icon":113,"link":91,"title":114,"description":115},"Barcelona Rooted","images/icons/rooted.png","Arraigados en Barcelona","Celebrar la cultura mediterránea a través de conceptos auténticos e inspirados localmente",{"title":57,"description":117,"teamSection":118,"ceo":122,"boardOfDirectors":126,"administration":139,"digitalAndMarketing":152,"executiveChef":166,"teamMembers":173},"Las personas detrás de nuestros distintivos conceptos de restaurantes",{"eyebrow":119,"title":120,"description":121},"Nuestra Gente","Conoce al *Equipo*","Las mentes y manos detrás de cada decisión, estrategia e innovación.",{"name":123,"role":124,"bio":31,"image":125},"Suresh Sharma","Director Ejecutivo","/images/team/sureshSharma.jpeg",[127,130,133,136],{"name":128,"image":129},"Dinesh Raj Regmi","/images/team/dineshRegmi.jpeg",{"name":131,"image":132},"Bidur Gautam","/images/team/bidurGautam.jpeg",{"name":134,"image":135},"RajKumar KC","/images/team/rajkumarKc.jpeg",{"name":137,"image":138},"Prakash Bhattrai","/images/team/prakashBhattrai.jpeg",[140,143,146,149],{"name":141,"image":142},"Suja Poudel","/images/team/sujaPoudel.jpeg",{"name":144,"image":145},"Abishek Regmi","/images/team/abishek.jpeg",{"name":147,"image":148},"Shiva Prasad Poudel","/images/team/shivaPoudel.jpeg",{"name":150,"image":151},"Prabesh Poudel","/images/team/prabeshPoude.jpeg",[153,156,159,163],{"name":154,"image":155},"Diwash Sharma","/images/team/diwashSharma.jpeg",{"name":157,"image":158},"Sabina Acharya","/images/team/sabina.jpeg",{"name":160,"role":161,"image":162},"Shivam Adhikari","Especialista en Marketing","/images/team/marketing/shivam-adhikari.jpeg",{"name":164,"role":161,"image":165},"Pariskar Rijal","/images/team/marketing/pariskar-rijal.jpeg",[167,170],{"name":168,"image":169},"Romell Andres","/images/team/RomellAndres.jpeg",{"name":171,"image":172},"Nicola Franzese","/images/team/nicolaFranzese.jpeg",[174,178,181,184,187,190,193,196,199,202,205],{"name":175,"role":176,"image":177},"Nagendra","Miembro del Equipo","/images/team/nagendraPakhrin.jpeg",{"name":179,"role":176,"image":180},"Rajesh Sharma","/images/team/rajeshSharma.jpeg",{"name":182,"role":176,"image":183},"Govinda Timilsina","/images/team/govindaTimilsina.jpeg",{"name":185,"role":176,"image":186},"Bishnu Acharya","/images/team/bishnuAcharya.jpeg",{"name":188,"role":176,"image":189},"Beebek Poudel","/images/team/members/beebek-poudel.jpeg",{"name":191,"role":176,"image":192},"Jeevan Poudel","/images/team/members/jeevan-poudel.jpeg",{"name":194,"role":176,"image":195},"Prabin Subedi","/images/team/members/prabin-subedi.jpeg",{"name":197,"role":176,"image":198},"Pukar Rijal","/images/team/members/pukar-rijal.jpeg",{"name":200,"role":176,"image":201},"Roshan Khadka","/images/team/members/roshan-khadka.jpeg",{"name":203,"role":176,"image":204},"Sapana Adhikari","/images/team/members/sapana-adhikari.jpeg",{"name":206,"role":176,"image":207},"Sudip Pandey","/images/team/members/sudip-pandey.jpeg",{"title":58,"description":209,"ctaText":20,"ctaLink":21,"list":210},"Lleve el auténtico sabor de España a su evento con nuestros servicios de catering. Ofrecemos preparación de paella en vivo, una selección de tapas tradicionales y una variedad de deliciosos aperitivos, todos preparados con ingredientes frescos y de alta calidad. Perfecto para eventos privados, fiestas y reuniones corporativas, nuestro catering crea una experiencia gastronómica memorable que encantará a sus invitados.",[211,215],{"name":212,"image":75,"video":213,"link":76,"title":212,"description":214},"Preparación de paella en vivo","/videos/paella.mp4","Disfrute de la auténtica paella española preparada en vivo en su evento. Nuestros chefs cocinan ingredientes frescos en el lugar, creando un plato delicioso y una experiencia memorable para sus invitados. 🍤🥘",{"name":216,"image":217,"link":86,"title":216,"description":218},"Catering de tapas","/images/services/tapas.jpg","Ofrezca una amplia selección de tapas españolas tradicionales, perfectas para compartir y disfrutar con bebidas. Desde clásicas patatas bravas hasta tablas de jamón ibérico y queso, nuestras tapas llevan los auténticos sabores de España a su evento. 🍢🇪🇸",{"title":220,"description":221,"ctaText":20,"ctaLink":21,"list":222},"Decoración Floral","Transforme su espacio con nuestros impresionantes servicios de decoración floral. Desde elegantes ramos hasta elaboradas instalaciones, creamos hermosos arreglos florales que añaden un toque de naturaleza y sofisticación a cualquier evento. Perfecto para bodas, fiestas y ocasiones especiales.",[223],{"name":224,"image":225,"link":86,"title":224,"description":226},"Instalaciones para eventos","/images/services/flowers.jpg","Instalaciones florales personalizadas diseñadas para realzar el espacio de su evento. Desde centros de mesa hasta fondos, creamos exhibiciones impresionantes que dejan una impresión duradera.",{"title":228,"description":229,"ctaText":20,"ctaLink":21,"list":230},"Fotografía","Capture sus momentos especiales con nuestros servicios profesionales de fotografía. Desde retratos hasta eventos, creamos imágenes impresionantes que cuentan su historia. Perfecto para bodas, fiestas y ocasiones especiales.",[231],{"name":232,"image":233,"link":86,"title":232,"description":234},"Fotografía de eventos","/images/services/photo.jpg","Fotografía de eventos personalizada diseñada para realzar el espacio de su evento. Desde centros de mesa hasta fondos, creamos exhibiciones impresionantes que dejan una impresión duradera.",true,"/es-es",{"title":5,"description":13},"es-es/index","Ya2lY0e2CrwCvTU3XmAWArVI6kC_peMtPfhpHQ24lgA",{"id":4,"title":5,"body":241,"description":13,"extension":14,"meta":245,"navigation":235,"path":236,"seo":317,"stem":238,"__hash__":239},{"type":7,"value":242,"toc":243},[],{"title":10,"searchDepth":11,"depth":11,"links":244},[],{"heroSection":246,"aboutSection":247,"introSection":248,"contactSection":249,"gallerySection":250,"multimediaText":252,"footer":255,"restaurantsSection":262,"visionSection":269,"teamPage":274,"cateringSection":307,"flowerDecorationSection":311,"photoSection":314},{"title":17,"description":18,"image":19,"ctaText1":20,"ctaLink":21,"restaurantsLink":22,"ctaText2":23},{"title":17,"description":25,"image":26,"linkText":27,"link":28},{"title":30,"description":31,"image":26},{"title":33,"subtitle":34,"ctaText":20,"image":35,"ctaLink":21},{"images":251,"showVertical":38},[19,19,19,19,19,19],[253,254],{"videoSrc":41,"videoPoster":19,"title":42,"description":43,"textPosition":44},{"videoSrc":41,"videoPoster":19,"title":46,"description":47,"textPosition":48},{"restaurant":256,"quickLinks":257,"contact":258,"hours":259},{"name":17,"tagline":51},{"title":53,"home":5,"menu":54,"about":55,"contact":56,"team":57,"catering":58},{"title":20,"phone":60,"email":61,"address":62},{"title":64,"weekdays":260,"weekend":261},{"days":66,"hours":67},{"days":69,"hours":70},{"title":54,"description":43,"list":263},[264,265,266,267,268],{"name":74,"image":75,